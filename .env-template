# Kopieren nach .env und ausfuellen. Die .env gehoert nie ins Repo.

# Discord Developer Portal -> Anwendung -> Bot -> Reset Token
DISCORD_TOKEN=

# Kanal-IDs: in Discord Entwicklermodus an, Rechtsklick auf Kanal -> Kanal-ID kopieren
DISCORD_KANAL_WILLKOMMEN=
DISCORD_KANAL_FEEDS=
# Optional eigene Kanaele je Feed (sonst DISCORD_KANAL_FEEDS)
DISCORD_KANAL_TWITCH=
DISCORD_KANAL_YOUTUBE=
DISCORD_KANAL_BLUESKY=
# Optional: Rollen-ID, die bei der Live-Meldung angepingt wird
DISCORD_ROLLE_LIVE=

# Dieselbe Twitch-Anwendung wie beim Twitch-Bot (CT 103) reicht
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_KANAL=nhywyll

